# .env.example — names only, never real values (secrets live in Railway Variables).
# Full table: CLAUDE.md → Environment Variables.
SUPABASE_DB_URL=
JWT_SECRET=
ADMIN_TOKEN=
ADMIN_JWT_SECRET=
ADMIN_URL_TOKEN=
SCHEDULER_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
REDIS_URL=
WS_ALLOWED_ORIGINS=
APP_ENV=production
# Client IP (server.py → get_client_ip): x_real_ip (default — Railway) / xff_left / xff_right / peer.
# Missing X-Real-IP → request.client.host.
CLIENT_IP_SOURCE=x_real_ip
TRUSTED_PROXY_HOPS=
LOG_CLIENT_IP=
